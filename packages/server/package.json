{
  "name": "@civ/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/lib.js",
  "types": "./dist/src/lib.d.ts",
  "exports": { ".": { "types": "./dist/src/lib.d.ts", "default": "./dist/src/lib.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "seed:test-user": "tsx src/seed-test-user.ts",
    "migrate:user-roles": "tsx src/migrate-user-roles.ts"
  },
  "dependencies": {
    "@civ/engine": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
