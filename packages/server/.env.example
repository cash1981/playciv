# @civ/server configuration. Copy this file to `.env` in this same folder
# (packages/server/.env) for local development; that file is gitignored.
# `src/load-env.ts` loads it on startup. In production set these in the host's
# secret/config store instead — never commit real secrets.

# MongoDB connection string. When set, MongoDB replaces the JSON-file storage.
# Keep the real production value in a password manager / the host's secrets.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Database name inside the cluster. Defaults to "playciv" when unset.
MONGO_DB=playciv

# Secret used to sign bearer tokens. Set a long random value in production;
# when unset the server generates a random one and every sign-in is invalidated
# on restart.
TOKEN_SECRET=

# HTTP server binding. Defaults: PORT 8787, HOST 127.0.0.1.
PORT=8787
HOST=127.0.0.1

# Allowed CORS origins, comma separated, e.g. https://your-domain.example.
# Defaults to everything when unset.
CORS_ORIGIN=
