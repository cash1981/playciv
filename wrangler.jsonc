{
  // Cloudflare Worker for playciv.app. Stage 0 spike: serve the built SPA and
  // prove that the MongoDB driver reaches Atlas and node:crypto scrypt runs on
  // workerd, before porting the real API in Stage 1.
  //
  // Secrets (MONGO_URL, TOKEN_SECRET) are NOT set here — add them in the
  // Cloudflare dashboard under the Worker's Settings > Variables and secrets,
  // or with `wrangler secret put`. This file is committed, so it holds no
  // secrets.
  "name": "playciv",
  "main": "packages/worker/src/index.ts",
  "compatibility_date": "2026-09-18",
  // node:crypto (scrypt) and the mongodb driver need Node built-ins on workerd.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Built by `pnpm run build` (packages/web). Served for every non-/api path,
    // with index.html returned for unknown client-side routes.
    "directory": "packages/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Run the Worker before static-asset routing. Without this, the SPA
    // not_found_handling above answers /api/* with index.html and the Worker's
    // fetch handler is never reached. The Worker serves non-/api paths itself
    // via env.ASSETS.fetch.
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
